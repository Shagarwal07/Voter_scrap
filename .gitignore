# ==============================================================================
# Voter_scrap Root .gitignore (Data Pipeline & Python Core)
# Client and Server frontend apps maintain their own isolated .gitignore files.
# ==============================================================================

# Secrets & Cloud Credentials
.env
.env.*
*.pem
*.key
*.p12
*service-account*.json
*credential*.json

# Python Runtime & Virtual Environments
venv/
env/
.venv/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage

# SQLite Databases & Working Journals
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.db.backup*

# Heavy Scanned PDFs & Extracted Outputs (Preserve staging READMEs)
*.pdf
Raw_data/**
!Raw_data/
!Raw_data/README.md
outputs/**
!outputs/
!outputs/README.md

# Internal Documentation & Prep
docs/INTERVIEW_PREP.md

# OS & Editor Artifacts
.DS_Store
Thumbs.db
*.tmp
*.log
.vscode/
.idea/
