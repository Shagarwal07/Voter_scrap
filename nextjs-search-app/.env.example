# ====================================================================
# Voter Search App & Live Voting Pad - Environment Template
# Copy this file to .env.local to configure your secrets locally.
# DO NOT commit .env.local into version control (git ignored).
# ====================================================================

# 1. Cloud PostgreSQL (Neon / Supabase) — 100% Stateless Auth & Cloud Run / Vercel
# Format: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
DATABASE_URL=""

# 2. Connected Frontend URL (Civic Portal)
NEXT_PUBLIC_FRONTEND_URL="http://localhost:3000"

# 3. NextAuth Configuration (Google OAuth)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NEXTAUTH_SECRET="local-dev-secret-key-32charsminimum-voter-scrap"
# In Development: http://localhost:3001
# In Production: https://your-production-domain.com (Must match Google Cloud Console OAuth Authorized Redirect URI)
NEXTAUTH_URL="http://localhost:3001"

# 4. Superuser Privileges (Unrestricted Searches across All Wards/Parts)
DEVELOPER_EMAIL="developer@example.com"
ADMIN_EMAIL="admin@example.com"

# 5. Google Cloud Storage (GCP) Credentials (For streaming signed PDF reports & cloud sync)
# Option A: Direct Service Account credentials
GCP_PROJECT_ID=""
GCP_CLIENT_EMAIL=""
GCP_PRIVATE_KEY=""
# Option B: Path to Service Account JSON keyfile
# GOOGLE_APPLICATION_CREDENTIALS="/path/to/service-account.json"
GCS_BUCKET_NAME="ocr-voter-lists-archive"
